Filter < UIFilter
  id: filter
  size: 250 40
  image-source: /images/ui/windows/filter/filter_background
  image-border: 5
  image-color: white
  $disabled:
    image-color: #7E828B

  @onStateChange: |
    function(self, state)
      for _, child in ipairs(self:getChildren()) do
        child:setOn(state)
      end
    end
  @onClick: |
    self:filterClicked()

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    image-source: /images/ui/windows/filter/filter_panel_icon
    size: 20 20
    image-color: white
    phantom: true
    $on:
      image-color: #36F991
    $disabled:
      image-color: #7E828B
  
  UIWidget
    id: text
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    text: Filter
    font: poppins-14
    text-color: #CED2D9
    margin-left: 10
    phantom: true
    text-auto-resize: true
    text-offset: 0 1
    $on:
      text-color: #36F991
    $disabled:
      text-color: #7E828B

  UIWidget
    id: indicative
    size: 20 20
    anchors.left: text.right
    anchors.verticalCenter: text.verticalCenter
    image-source: /images/ui/windows/filter/filter_indicative
    text-color: #18181B
    text-offset: 1 2
    font: poppins-14
    margin-left: 5
    visible: true
    opacity: 1.0
    @onSetup: |
      function(self)
        self:setEnabled(false)
      end
    @onClick: |
      self:getParent():clearAllFilters()
    $hover:
      opacity: 1.0
      image-source: /images/ui/windows/filter/filter_indicative_clear
      text-offset: 50 50
    $hover disabled:
      visible: false
    $pressed:
      opacity: 0.9
    $pressed disabled:
      visible: false
    $disabled:
      visible: false

  UIWidget
    id: arrow
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/windows/filter/filter_panel_arrow_down
    size: 20 20
    phantom: true
    margin-right: 10
    image-color: white
    $on:
      image-source: /images/ui/windows/filter/filter_panel_icon_active
    $disabled:
      image-color: #7E828B

FilterMenu < UIPopupMenu
  image-source: /images/ui/windows/filter/filter_popup_background
  image-border: 5
  padding: 10
  width: 250

FilterMenuSeparator < UIWidget
  background-color: #25272C
  height: 1
  phantom: true

FilterButtonExpandMenu < UIWidget
  height: 30
  text-align: left
  font: poppins-12
  text-horizontal-auto-resize: true
  text-align: top-left
  text-color: #CED2D9
  text-offset: 0 10
  text: normal button
  $on:
    text-color: #36F991
  $disabled:
    text-color: #3A3D43
  $hover:
    text-color: #36F991
  @onStateChange: |
    function(self, state)
      self.arrow:setOn(state)
    end
  @onCheckChange: |
    function(self, state)
      self.arrow:setChecked(state)
    end

  UIWidget
    id: arrow
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 5
    image-source: /images/ui/windows/filter/filter_panel_icon_expand
    $on:
      image-source: /images/ui/windows/filter/filter_panel_icon_expanded
    $disabled:
      image-source: /images/ui/windows/filter/filter_panel_icon_expand_disabled
    $checked:
      visible: false

  UIWidget
    id: content
    anchors.left: parent.left
    anchors.right: arrow.left
    anchors.top: parent.top
    margin-top: 30
    layout:
      type: verticalBox
      fit-children: true
    @onGeometryChange: |
      local height = self:getHeight() + self:getMarginTop()
      self:getParent():setHeight(height)

FilterButtonClearAll < UIWidget
  id: clear_button
  text: Clear all
  font: poppins-semibold-14
  text-color: #CED2D9
  $disabled:
    text-color: #7E828B
  enabled: false
  margin-top: 5
  opacity: 1
  $hover:
    opacity: 0.75
  $pressed:
    opacity: 0.5
  text-auto-resize: true
  text-align: center
  @onEnableChange: |
    if not self.underscore then
      return
    end
    self.underscore:setOn(self:isEnabled())

  UIWidget
    id: underscore
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    height: 1
    background-color: #595c64

    @onSetup: |
      self:setWidth(self:getParent():getTextSize().width + 2)

FilterButtonSort < UIWidget
  height: 30
  text-align: left
  font: poppins-12
  text-horizontal-auto-resize: true
  text-align: top-left
  text-color: #CED2D9
  text-offset: 0 10
  text: sort button
  $on:
    text-color: #36F991
  $disabled:
    text-color: #3A3D43
  $hover:
    text-color: #36F991
  @onStateChange: |
    function(self, state)
      self.sort_button:setOn(state)
    end
  @onCheckChange: |
    function(self, state)
      self.sort_button:setChecked(state)
    end

  UIWidget
    id: sort_button
    size: 9 40
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    phantom: true
    text-color: #CED2D9
    UIWidget
      id: asc
      image-source: /images/ui/windows/filter/filter_sort_descending
      anchors.bottom: base.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 2
      $on:
        image-source: /images/ui/windows/filter/filter_sort_descending_on
    UIWidget
      id: base
      image-source: /images/ui/windows/filter/filter_sort_base
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
    UIWidget
      id: desc
      image-source: /images/ui/windows/filter/filter_sort_ascending
      anchors.top: base.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      $on:
        image-source: /images/ui/windows/filter/filter_sort_ascending_on

FilterOption < UIWidget
  height: 30
  font: poppins-12
  text-align: left
  text-horizontal-auto-resize: true
  text-color: #CED2D9
  text-offset: 40 2
  $on:
    text-color: #36F991
  $hover:
    text-color: #36F991

  CheckBox
    id: checkbox
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 20 20
    margin-left: 10
    phantom: true

FilterSubLabel < UIWidget
  id: label
  height: 30
  text-align: left
  text-offset: 10 2
  font: poppins-12
  text-horizontal-auto-resize: true
  text-color: #CED2D9
